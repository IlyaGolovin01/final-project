# ===========================================================================
#  Настройки бота поддержки «Продаем все на свете»
#  Скопируйте этот файл в .env и заполните значения.
#      Windows:        copy .env.example .env
#      Linux / macOS:  cp .env.example .env
#  Формат: ПАРАМЕТР=значение, по одному в строке. Кавычки не нужны.
#  Строки с # — комментарии. Пустое значение = используется значение по умолчанию.
#  После любого изменения файла бота нужно перезапустить.
# ===========================================================================

# --- Обязательное ----------------------------------------------------------
# Токен от @BotFather. Это пароль от бота — не публикуйте его.
BOT_TOKEN=

# --- Сотрудники (Telegram ID через запятую) --------------------------------
# ID можно узнать: сотрудник пишет боту команду /id.
# Суперадминистраторы: оба отдела, статистика, /export, /reload.
ADMIN_IDS=
# Технический отдел: сайт, оплата, личный кабинет.
IT_STAFF_IDS=
# Отдел продаж: товары, заказы, доставка, возвраты, гарантия.
SALES_STAFF_IDS=

# --- Данные магазина (подставляются в тексты бота) -------------------------
SHOP_NAME=Продаем все на свете
SHOP_SITE=https://prodaem-vse.example
SUPPORT_PHONE=8 800 000-00-00
SUPPORT_EMAIL=support@prodaem-vse.example
WORKING_HOURS=ежедневно с 09:00 до 21:00 (МСК)
# Обещанный срок первого ответа по заявке, часы.
SLA_HOURS=24

# --- Файлы и журналы -------------------------------------------------------
# Пути можно не указывать: по умолчанию файлы берутся из папки проекта.
# Задавайте их только если храните базу или FAQ в другом месте —
# тогда лучше писать полный путь, например D:\support\support.db
# DB_PATH=
# FAQ_PATH=
# DEBUG — подробно, INFO — обычно, WARNING — только проблемы.
LOG_LEVEL=INFO
# Укажите имя файла, чтобы писать журнал на диск, например bot.log.
LOG_FILE=

# --- Поиск по базе знаний --------------------------------------------------
# Выше этой оценки бот отвечает сразу (больше значение — строже бот).
FAQ_DIRECT_THRESHOLD=0.50
# Выше этой оценки бот предлагает похожие вопросы кнопками.
FAQ_SUGGEST_THRESHOLD=0.20
# Сколько вариантов показывать в подсказке.
FAQ_MAX_SUGGESTIONS=3

# --- Голосовые сообщения ---------------------------------------------------
# none — не распознавать (бот попросит написать текстом)
# openai — распознавание через Whisper API, нужен OPENAI_API_KEY
STT_PROVIDER=none
OPENAI_API_KEY=
# Совместимый шлюз вместо api.openai.com — если используете свой.
OPENAI_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
# Язык распознавания. Пусто — сервис определит его сам.
STT_LANGUAGE=ru
STT_TIMEOUT=60
# Максимальная длительность голосового сообщения, секунды.
STT_MAX_DURATION=120

# --- Прочее ----------------------------------------------------------------
# Присылать сотрудникам новые заявки в личку.
NOTIFY_STAFF=true
# Максимальная длина описания проблемы в заявке.
MAX_TICKET_TEXT=2000
# Сколько заявок показывать на одной странице в панели поддержки.
ADMIN_PAGE_SIZE=5
